{
  "name": "ai-jue-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "description": "Monorepo for the ai-jue project",
  "main": "index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "security-scan": "node scripts/security-scan.js",
    "test": "vitest run",
    "build": "turbo run build",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "site:build": "npm run docs:build",
    "check-consistency": "node scripts/check-consistency.js",
    "check-base-i18n": "node scripts/check-base-i18n.js",
    "smoke-apply": "node scripts/smoke-apply.js",
    "smoke:preset-local": "node scripts/smoke-local-preset.js --packages-dir packages/ai-jue/test/fixtures/local-preset-monorepo --entry jue-preset-neutral-bundle --cleanup delete",
    "release-gate:v1.1": "node scripts/release-gate-v1.1.js",
    "prerelease": "npm run release-gate:v1.1",
    "setup": "npm install && npm dedupe",
    "release": "node scripts/release.js",
    "publish": "node scripts/release.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "dompurify": "3.4.13",
    "mermaid": "11.16.1"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^25.0.10",
    "conventional-changelog-cli": "^5.0.0",
    "enquirer": "^2.4.1",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
